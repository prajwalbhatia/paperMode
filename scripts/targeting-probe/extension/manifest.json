{
  "manifest_version": 3,
  "name": "PaperMode Targeting Probe (QA only)",
  "version": "0.1.0",
  "description": "Isolated exact-video playback feasibility experiment. No PaperMode integration.",
  "permissions": ["scripting", "storage"],
