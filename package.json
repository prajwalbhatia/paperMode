{
  "name": "papermode",
  "productName": "PaperMode",
  "version": "0.1.2",
  "paperModeReleaseTag": "v0.1.2-preview.1",
  "description": "A macOS menu bar utility for watching courses while taking paper notes.",
  "private": true,
  "main": "src/main/index.js",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "build:icons": "swift -module-cache-path .build/module-cache scripts/build-icons.swift . && iconutil -c icns .build/PaperMode.iconset -o assets/PaperMode.icns",
    "build:native": "node scripts/build-native.js",
    "start": "npm run build:native && electron_config_cache=.build/electron-cache electron .",
    "check:native": "npm run build:native && node scripts/check-native.js",
    "check:app": "npm run build:native && electron_config_cache=.build/electron-cache electron . --smoke-test",
    "package": "node scripts/package.js",
    "package:hardened-local": "PAPERMODE_SIGNING_MODE=hardened-local node scripts/package.js",
    "package:developer-id": "PAPERMODE_SIGNING_MODE=developer-id node scripts/package.js",
    "check:package": "node scripts/check-package.js",
    "check:developer-id": "node scripts/check-developer-id.js",
    "notarize:developer-id": "node scripts/notarize-release.js",
    "test": "node --test tests/*.test.js",
    "test:native": "node scripts/test-native.js",
    "preview:native": "npm run build:native && .build/native/papermode-helper --preview",
    "test:lock": "npm run build:native && .build/native/papermode-helper --test-lock",
    "start:test": "npm run build:native && electron_config_cache=.build/electron-cache electron . --bounded-locks",
    "test:ipc": "node --test tests/integration/*.test.js",
    "release:local": "node scripts/prepare-local-release.js",
    "release:preview": "node scripts/prepare-local-release.js --prerelease"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "@electron-forge/cli": "8.0.1"
  },
  "license": "MIT"
}
